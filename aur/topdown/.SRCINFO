pkgbase = topdown
	pkgdesc = One TUI to launch, resume and manage coding agents and their conversations
	pkgver = 0.9.4
	pkgrel = 1
	url = https://github.com/viniemm/topdown
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = go
	depends = bash
	depends = glibc
	depends = hicolor-icon-theme
	depends = util-linux
	optdepends = omarchy: launch through omarchy-agent, plan-usage meters, theme colours
	optdepends = hyprland: switch to an already-open conversation
	optdepends = xdg-terminal-exec: open agents in a new terminal window
	optdepends = glib2: trash files that live on another filesystem
	optdepends = libnotify: show errors from a keybinding as a notification
	optdepends = zoxide: rank folder suggestions by frecency
	options = !debug
	source = topdown-0.9.4.tar.gz::https://github.com/viniemm/topdown/archive/refs/tags/v0.9.4.tar.gz
