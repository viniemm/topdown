# Maintainer: Vinayak Mathur <vinayakrulez@gmail.com>

pkgname=topdown
pkgver=0.10.0
pkgrel=1
pkgdesc='One TUI to launch, resume and manage coding agents and their conversations'
arch=('x86_64' 'aarch64')
url='https://github.com/viniemm/topdown'
license=('MIT')
# bash runs the Omarchy shim, setsid (util-linux) detaches new windows, and
# glibc's ld.so loads the PIE binary: namcap can't see any of the three.
depends=('bash' 'glibc' 'hicolor-icon-theme' 'util-linux')
makedepends=('go')
options=('!debug')   # stripped at link time (-s -w)
optdepends=('omarchy: launch through omarchy-agent, plan-usage meters, theme colours'
            'hyprland: switch to an already-open conversation'
            'xdg-terminal-exec: open agents in a new terminal window'
            'glib2: trash files that live on another filesystem'
            'libnotify: show errors from a keybinding as a notification'
            'zoxide: rank folder suggestions by frecency')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c2e75a2f7af1304735ee1bcd3e5135b03c3109695645945e0793b70cda2eec41')

prepare() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  go mod download -modcacherw
}

build() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  export CGO_ENABLED=0
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -ldflags "-s -w -bindnow -X main.version=$pkgver" -o topdown ./cmd/topdown
}

check() {
  cd "$pkgname-$pkgver"
  export GOPATH="$srcdir/gopath"
  go test ./cmd/... ./internal/...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 topdown "$pkgdir/usr/bin/topdown"
  install -Dm644 pkgbuild/topdown.desktop "$pkgdir/usr/share/applications/topdown.desktop"
  install -Dm644 pkgbuild/topdown.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/topdown.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
