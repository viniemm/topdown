#!/bin/bash
# omarchy-agent-launcher: a curated TUI launcher for coding agents and other terminal apps.
#
#   omarchy-agent-launcher open          Open the picker in a new terminal window (Super+Shift+A)
#   omarchy-agent-launcher default       Launch the default agent; no default -> picker to choose one (Super+A)
#   omarchy-agent-launcher pick          Run the picker in the current terminal
#   omarchy-agent-launcher launch <id>   Launch one app from the list
#   omarchy-agent-launcher add           Add an app interactively
#   omarchy-agent-launcher rm <id>       Remove an app
#   omarchy-agent-launcher delete <key>  Delete a row (asks first): a conversation, or an app from the list
#   omarchy-agent-launcher resume <key>  Resume a session row (ses|agent|id|cwd) in its project directory
#
# Picker keys: Enter launch/resume in this window · Alt-Enter in a new window
#              Tab apps ↔ recent conversations · → an agent's conversations · ← back
#              Ctrl-D set default agent
#              Ctrl-R refresh usage · Ctrl-A add · Ctrl-X/Del delete (asks first) · Esc close
#
# The right pane reads the usage records the bar's agents plugin watches
# (~/.local/state/omarchy/agents/usage/) and each agent's own session store.
# Data/preview logic: agent_launcher.py (see HELPER below)
#
# The list lives in ~/.config/omarchy/agent-launcher.json. Entries either name an
# Omarchy-known agent ("agent": "claude"), launched exactly like omarchy-agent
# does (auto-permission flags, account pinning, Omarchy's ~/Work cwd, agent window class),
# or carry a plain "command" run in a terminal with the same cwd and class.

set -euo pipefail

SELF="$(readlink -f "$0")"
LIST="$HOME/.config/omarchy/agent-launcher.json"
DEFAULT_FILE="$HOME/.config/omarchy/defaults/agent"
SHIM="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-agent-launcher/shim"
# Installed: /usr/lib/omarchy-agent-launcher; from a checkout: ../lib next to bin/.
HELPER="$(dirname "$SELF")/../lib/agent_launcher.py"
[[ -f $HELPER ]] || HELPER="/usr/lib/omarchy-agent-launcher/agent_launcher.py"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-agent-launcher/launch.log"

known_agents() {
  # Agent ids Omarchy knows how to launch, from omarchy-default-agent's own docs.
  grep -m1 '^# omarchy:args=' "$(command -v omarchy-default-agent)" |
    sed -E 's/.*\[(.*)\].*/\1/' | tr '|' '\n'
}

ensure_list() {
  [[ -f $LIST ]] && return
  mkdir -p "$(dirname "$LIST")"
  cat >"$LIST" <<'EOF'
[
  {"id": "claude", "label": "Claude Code", "agent": "claude"},
  {"id": "omp", "label": "Oh My Pi", "agent": "omp"},
  {"id": "pi", "label": "Pi", "agent": "pi"},
  {"id": "hermes", "label": "Hermes", "agent": "hermes"},
  {"id": "agy", "label": "Antigravity", "agent": "agy"}
]
EOF
}

# omarchy-agent builds each agent's command (auto-permission flags, account
# pinning, ~/Work cwd). Two stand-ins on PATH let it run the picked agent rather
# than the default, and hand its command back for us to add resume arguments,
# pin the session's directory, and run it inline or in a new terminal.
ensure_shim() {
  mkdir -p "$SHIM"
  cat >"$SHIM/omarchy-default-agent" <<'EOF'
#!/bin/bash
echo "$AGENT_LAUNCHER_AGENT"
EOF
  cat >"$SHIM/omarchy-launch-tui" <<EOF
#!/bin/bash
# Leave PATH as it was, so nothing inside the agent session sees these stand-ins.
PATH=\$(tr ':' '\n' <<<"\$PATH" | grep -vxF "$SHIM" | paste -sd:)
app_id=--app-id=org.omarchy.agent
[[ \$1 == --app-id=* ]] && app_id=\$1 && shift
cmd=("\$@")
[[ -n \${AGENT_LAUNCHER_ARGS:-} ]] && mapfile -t -O "\${#cmd[@]}" cmd <<<"\$AGENT_LAUNCHER_ARGS"
# omarchy-agent moves launches from \$HOME to ~/Work; a resumed session must
# start in its own project dir, so pin it on the command itself.
[[ -n \${AGENT_LAUNCHER_CWD:-} ]] && cmd=(env -C "\$AGENT_LAUNCHER_CWD" "\${cmd[@]}")
inline=\${AGENT_LAUNCHER_INLINE:-}
unset AGENT_LAUNCHER_AGENT AGENT_LAUNCHER_ARGS AGENT_LAUNCHER_CWD AGENT_LAUNCHER_INLINE
[[ -n \$inline ]] && exec "\${cmd[@]}"
exec omarchy-launch-tui "\$app_id" "\${cmd[@]}"
EOF
  chmod +x "$SHIM"/*
}

# run_agent <agent> [cwd] [resume args...]: launch through omarchy-agent.
run_agent() {
  local agent=$1 cwd=${2:-}
  shift 2 || shift $#
  ensure_shim
  AGENT_LAUNCHER_AGENT=$agent AGENT_LAUNCHER_CWD=$cwd AGENT_LAUNCHER_ARGS=$(printf '%s\n' "$@") \
    PATH="$SHIM:$PATH" exec omarchy-agent
}

json() { python3 -I - "$LIST" "$@"; }

field() { # field <id> <key>
  json "$1" "$2" <<'EOF'
import json, sys
path, id_, key = sys.argv[1:]
for e in json.load(open(path)):
    if e.get("id") == id_:
        print(e.get(key, ""))
        break
EOF
}

current_default() { [[ -f $DEFAULT_FILE ]] && head -n1 "$DEFAULT_FILE" || true; }

helper() { python3 -I "$HELPER" "$@"; }

cmd_rows() {
  ensure_list
  helper rows ${AGENT_LAUNCHER_STATE:+--state "$AGENT_LAUNCHER_STATE"}
}

PAGE=30         # conversations loaded at a time
SEARCH_LIMIT=300 # conversations searched once you start typing

# The picker's own state lives in $AGENT_LAUNCHER_STATE.nav; what the last
# list load found (has_more, first_session) is in .rows, written by `rows`.
# mode: "all" (apps + every agent's conversations) or an agent id (Right on its
# app row). pending: a cursor position to apply once the next reload has loaded
# (a number, or "sessions" for wherever the conversations start).
save_state() {
  printf 'limit=%s\nlastpos=%s\nsorted=%s\nmode=%s\npending=%s\nreturn_pos=%s\n' \
    "${limit:-$PAGE}" "${lastpos:-1}" "${sorted:-0}" "${mode:-all}" "${pending:-}" "${return_pos:-1}" \
    >"$AGENT_LAUNCHER_STATE.nav.tmp" && mv -f "$AGENT_LAUNCHER_STATE.nav.tmp" "$AGENT_LAUNCHER_STATE.nav"
}

# fzf event handler: prints the fzf action(s) to run. Kept in bash (no Python)
# because focus fires on every cursor move.
#   nav focus|change|load|tab|right|left|enter <row key>
cmd_nav() {
  local event=$1 row=${2:-} limit lastpos sorted mode pending return_pos first_session has_more
  # shellcheck disable=SC1090
  source "$AGENT_LAUNCHER_STATE.nav" 2>/dev/null || true
  # shellcheck disable=SC1090
  source "$AGENT_LAUNCHER_STATE.rows" 2>/dev/null || true
  local pos=${FZF_POS:-1} matches=${FZF_MATCH_COUNT:-0} query=${FZF_QUERY:-}
  local reload="reload('$SELF' rows)"
  case "$event" in
  focus)
    if [[ $row == hdr\|* ]]; then
      # The divider isn't a stop: keep going the way the cursor was moving.
      if ((pos == 1 || (pos > ${lastpos:-0} && pos < matches))); then echo down; else echo up; fi
    elif [[ -z $query && $has_more == 1 ]] && ((pos >= matches - 3)); then
      # Near the end of what's loaded: fetch the next page, keeping the cursor
      # on this row (one-off tracking, so typing never waits on a reload).
      limit=$((${limit:-$PAGE} + PAGE))
      echo "track-current+$reload"
    fi
    lastpos=$pos
    ;;
  change)
    # While typing, rank by match quality (best first); with no query, back to
    # the sectioned order. Typing also searches a bigger slice of history.
    local actions=()
    if [[ -n $query && ${sorted:-0} == 0 ]]; then
      actions+=(toggle-sort) sorted=1
    elif [[ -z $query && ${sorted:-0} == 1 ]]; then
      actions+=(toggle-sort) sorted=0
    fi
    if [[ -n $query ]] && ((${limit:-$PAGE} < SEARCH_LIMIT)); then
      limit=$SEARCH_LIMIT
      actions+=("$reload")
    fi
    ((${#actions[@]})) && (IFS=+; echo "${actions[*]}")
    ;;
  load)
    # Apply a cursor move queued before a reload, now that the rows exist.
    if [[ -n ${pending:-} ]]; then
      [[ $pending == sessions ]] && pending=${first_session:-1}
      echo "pos($pending)"
      pending=
    fi
    ;;
  right)
    if [[ -n $query ]]; then
      echo forward-char
    elif [[ ${mode:-all} == all && $row == app\|* ]]; then
      local info agent label
      info=$(helper session-agent "$row")
      if [[ -n $info ]]; then
        IFS=$'\t' read -r agent label <<<"$info"
        mode=$agent return_pos=$pos pending=2 limit=$PAGE
        echo "$reload+change-border-label( $label )"
      fi
    fi
    ;;
  left)
    if [[ ${mode:-all} != all ]]; then
      # Back out of an agent's view, search and all (Ctrl-B still moves the text cursor).
      mode=all pending=${return_pos:-1} limit=$PAGE
      echo "${query:+change-query()+}$reload+change-border-label( Agents )"
    elif [[ -n $query ]]; then
      echo backward-char
    fi
    ;;
  tab)
    if [[ ${mode:-all} != all ]]; then
      # From one agent's view, Tab goes to everyone's recent conversations.
      mode=all pending=sessions limit=$PAGE
      echo "$reload+change-border-label( Agents )"
    elif [[ -z $query ]] && ((pos < ${first_session:-1})); then
      echo "pos(${first_session:-1})"
    else
      echo first
    fi
    ;;
  delete | del)
    # Ctrl-X, or Del with an empty search box (otherwise Del edits the query).
    if [[ $event == del && -n $query ]]; then
      echo delete-char
    elif [[ $row == app\|* || $row == ses\|* ]]; then
      pending=$pos
      echo "execute('$SELF' delete {1})+$reload"
    fi
    ;;
  enter)
    case "$row" in
    hdr\|*) ;;
    more\|*)
      limit=$((${limit:-$PAGE} + PAGE))
      echo "track-current+$reload"
      ;;
    *) echo accept ;;
    esac
    ;;
  esac
  save_state
}

cmd_set_default() {
  [[ ${1:?} == app\|* ]] || return 0
  local agent
  agent=$(field "${1#app|}" agent)
  if [[ -z $agent ]]; then
    echo "Only agents can be the default agent." >&2
    sleep 1
    return 1
  fi
  mkdir -p "$(dirname "$DEFAULT_FILE")"
  printf '%s\n' "$agent" >"$DEFAULT_FILE"
}

cmd_launch() {
  local id=${1:?usage: omarchy-agent-launcher launch <id>}
  ensure_list
  local agent command
  agent=$(field "$id" agent)
  command=$(field "$id" command)
  # Same convention as omarchy-agent: launches from $HOME start in ~/Work if it exists.
  [[ $PWD == "$HOME" && -d $HOME/Work ]] && cd "$HOME/Work"
  if [[ -n $agent ]]; then
    local -a args
    mapfile -t args < <(helper launch-args "$id")
    run_agent "$agent" "" "${args[@]}"
  elif [[ -n $command ]]; then
    [[ -n ${AGENT_LAUNCHER_INLINE:-} ]] && exec bash -lc "$command"
    exec omarchy-launch-tui --app-id=org.omarchy.agent bash -lc "$command"
  else
    echo "No app named '$id' in $LIST" >&2
    exit 1
  fi
}

cmd_pick() {
  ensure_list
  mkdir -p "$(dirname "$LOG")"
  source omarchy-restart-gum 2>/dev/null || true
  local header=$'Enter open · Alt-Enter new window · Tab recent · →/← agent\'s sessions\n^D default · ^R refresh usage · ^A add · ^X/Del delete'
  local setting_default=false
  if [[ ${1:-} == --choose-default ]]; then
    setting_default=true
    header="No default agent yet — Enter makes it the default and launches it"
  fi

  # Per-picker paging state, read by `rows` and `nav`.
  local state_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-agent-launcher"
  mkdir -p "$state_dir"
  export AGENT_LAUNCHER_STATE="$state_dir/pick.$$"
  printf 'limit=%s\n' "$PAGE" >"$AGENT_LAUNCHER_STATE.nav"
  trap 'rm -f "$AGENT_LAUNCHER_STATE".*' EXIT
  trap 'exit 130' HUP INT TERM

  local out key row
  out=$(
    cmd_rows | fzf --ansi --delimiter=$'\t' --with-nth=2.. --tabstop=2 \
      --layout=reverse --no-multi --info=hidden --no-sort \
      --id-nth=1 \
      --prompt="  " --pointer="▶" --gutter=" " --header="$header" --header-first \
      --border=rounded --border-label=" Agents " \
      --preview="python3 -I '$HELPER' preview {1}" \
      --preview-window="right,55%,border-left,wrap" \
      --expect=alt-enter \
      --bind "focus:transform:'$SELF' nav focus {1}" \
      --bind "change:transform:'$SELF' nav change {1}" \
      --bind "tab:transform:'$SELF' nav tab {1}" \
      --bind "right:transform:'$SELF' nav right {1}" \
      --bind "left:transform:'$SELF' nav left {1}" \
      --bind "load:transform:'$SELF' nav load {1}" \
      --bind "enter:transform:'$SELF' nav enter {1}" \
      --bind "ctrl-d:execute-silent('$SELF' set-default {1})+track-current+reload('$SELF' rows)" \
      --bind "ctrl-r:execute-silent('$SELF' refresh {1})+refresh-preview+track-current+reload('$SELF' rows)" \
      --bind "ctrl-a:execute('$SELF' add)+reload('$SELF' rows)" \
      --bind "ctrl-x:transform:'$SELF' nav delete {1}" \
      --bind "del:transform:'$SELF' nav del {1}"
  ) || exit 0
  rm -f "$AGENT_LAUNCHER_STATE".*
  key=$(sed -n 1p <<<"$out")
  row=$(sed -n 2p <<<"$out" | cut -f1)
  [[ -n $row ]] || exit 0
  [[ $key == alt-enter ]] || key=enter

  case "$row" in
  add\|*)
    cmd_add || true
    exec "$SELF" pick "$@"
    ;;
  ses\|*) run_picked "$key" resume "$row" ;;
  app\|*)
    $setting_default && cmd_set_default "$row"
    run_picked "$key" launch "${row#app|}"
    ;;
  *) exec "$SELF" pick "$@" ;; # Alt-Enter on the divider: just reopen
  esac
}

# run_picked <fzf key> <launch|resume> <arg>
run_picked() {
  local key=$1
  shift
  if [[ $key == enter ]]; then
    # Hand this terminal over to the agent. The window already carries the
    # agent class (org.omarchy.agent) and closes when the agent exits.
    printf '\033]2;%s\007' "$(helper title "$2" 2>/dev/null || echo Agent)"
    AGENT_LAUNCHER_INLINE=1 exec "$SELF" "$@"
  fi
  # Alt-Enter: a separate agent window. omarchy-launch-tui ends in
  # `systemd-run --scope`, which stays in the foreground until that terminal
  # closes, so setsid -f detaches it and the picker exits now. The new
  # terminal's own chatter goes to the log rather than this closing window.
  setsid -f "$SELF" "$@" </dev/null >>"$LOG" 2>&1
}

cmd_refresh() {
  local uid
  uid=$(helper usage-id "${1:?}")
  [[ -n $uid ]] && omarchy-agent-usage-update "$uid" &>/dev/null || true
}

cmd_resume() {
  # ses|<agent>|<session>|<cwd>
  local agent sid cwd args
  IFS='|' read -r _ agent sid cwd <<<"${1:?}"
  args=$(helper resume-args "$agent" "$sid") || exit 1
  [[ -d $cwd ]] || cwd=""
  local -a resume
  mapfile -t resume <<<"$args"
  run_agent "$agent" "$cwd" "${resume[@]}"
}

cmd_add() {
  ensure_list
  source omarchy-restart-gum 2>/dev/null || true
  local listed choice id label agent="" command=""
  listed=$(json <<<'import json,sys;[print(e.get("agent","")) for e in json.load(open(sys.argv[1]))]')
  choice=$(
    {
      while read -r a; do
        grep -qxF "$a" <<<"$listed" && continue
        if command -v "$a" &>/dev/null || [[ -x $HOME/.local/bin/$a ]]; then echo "agent: $a"; fi
      done < <(known_agents)
      echo "custom command…"
    } | gum filter --header "Add which app?" --placeholder "Type to filter installed agents"
  ) || return 0

  if [[ $choice == agent:* ]]; then
    agent=${choice#agent: }
    id=$agent
    label=$(gum input --header "Label" --value "$agent") || return 0
  else
    command=$(gum input --header "Command to run in a terminal" --placeholder "e.g. lazygit, aider --model sonnet") || return 0
    [[ -n $command ]] || return 0
    label=$(gum input --header "Label" --value "${command%% *}") || return 0
    id=$(tr -cs 'a-zA-Z0-9' '-' <<<"${label,,}" | sed 's/^-*//;s/-*$//')
  fi
  [[ -n $id && -n $label ]] || return 0

  json "$id" "$label" "$agent" "$command" <<'EOF'
import json, sys
path, id_, label, agent, command = sys.argv[1:]
apps = json.load(open(path))
base, n = id_, 2
while any(a["id"] == id_ for a in apps):
    id_, n = f"{base}-{n}", n + 1
entry = {"id": id_, "label": label}
entry["agent" if agent else "command"] = agent or command
apps.append(entry)
json.dump(apps, open(path, "w"), indent=2)
EOF
}

cmd_rm() {
  local id=${1:?}
  json "${id#app|}" <<'EOF'
import json, sys
path, id_ = sys.argv[1:]
apps = [a for a in json.load(open(path)) if a["id"] != id_]
json.dump(apps, open(path, "w"), indent=2)
EOF
}

cmd_delete() {
  local key=${1:?} question agent sid
  printf '\033[H\033[2J' # fzf hands over the normal screen; start from a clean one
  # The helper says why when it can't go ahead (e.g. the conversation is open).
  if ! question=$(helper delete-prompt "$key"); then
    read -rsn1 -p "Press any key to go back"
    return 0
  fi
  gum confirm "$question" || return 0
  case $key in
  app\|*) cmd_rm "$key" ;;
  ses\|*)
    IFS='|' read -r _ agent sid _ <<<"$key"
    helper delete "$agent" "$sid" || read -rsn1 -p "Press any key to go back"
    ;;
  esac
  return 0
}

cmd_open() {
  # A window with the agent class: Enter turns this very window into the agent.
  exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.agent --title=Agents -e "$SELF" pick "$@"
}

cmd_default() {
  local agent
  agent=$(omarchy-default-agent)
  [[ -n $agent ]] || cmd_open --choose-default
  local -a args
  mapfile -t args < <(helper launch-args "$agent")
  run_agent "$agent" "" "${args[@]}"
}

case "${1:-}" in
open) shift; cmd_open "$@" ;;
default) cmd_default ;;
pick) shift; cmd_pick "$@" ;;
launch) shift; cmd_launch "$@" ;;
add) cmd_add ;;
rm) shift; cmd_rm "$@" ;;
delete) shift; cmd_delete "$@" ;;
rows) cmd_rows ;;
nav) shift; cmd_nav "$@" ;;
resume) shift; cmd_resume "$@" ;;
refresh) shift; cmd_refresh "$@" ;;
set-default) shift; cmd_set_default "$@" ;;
*) sed -n '2,20p' "$SELF" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
