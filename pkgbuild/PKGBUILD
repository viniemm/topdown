pkgname=topdown
pkgver=0.9.3
pkgrel=1
pkgdesc='One TUI to launch, resume and manage coding agents and their conversations'
arch=('x86_64' 'aarch64')
url='https://github.com/viniemm/topdown'
license=('MIT')
depends=('bash' 'util-linux')   # the Omarchy shim is bash; setsid detaches new windows
optdepends=('omarchy: launch through omarchy-agent, plan-usage meters, theme colours'
            'hyprland: switch to an already-open conversation'
            'xdg-terminal-exec: open agents in a new terminal window'
            'glib2: trash files that live on another filesystem'
            'libnotify: show errors from a keybinding as a notification'
            'zoxide: rank folder suggestions by frecency')
makedepends=('go')
provides=('omarchy-agent-launcher')
conflicts=('omarchy-agent-launcher')
replaces=('omarchy-agent-launcher')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  export CGO_ENABLED=0 GOFLAGS="-trimpath -mod=readonly -modcacherw"
  go build -ldflags "-s -w -X main.version=$pkgver" -o "$srcdir/topdown" ./cmd/topdown
}

check() {
  cd "$startdir/.."
  go test ./cmd/... ./internal/...
}

package() {
  cd "$startdir/.."
  install -Dm755 "$srcdir/topdown" "$pkgdir/usr/bin/topdown"
  ln -s topdown "$pkgdir/usr/bin/omarchy-agent-launcher"   # old keybindings keep working
  install -Dm644 "$startdir/topdown.desktop" "$pkgdir/usr/share/applications/topdown.desktop"
  install -Dm644 "$startdir/topdown.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/topdown.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
